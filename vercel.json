{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/mappr/app",
      "destination": "https://mappr-9v19.vercel.app/"
    },
    {
      "source": "/mappr/app/",
      "destination": "https://mappr-9v19.vercel.app/"
    },
    {
      "source": "/mappr/app/:path*",
      "destination": "https://mappr-9v19.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/Excalifont-Regular.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(svg|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
